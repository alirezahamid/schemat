{
  "name": "@schemat/cli",
  "version": "0.2.1",
  "description": "Git-native database schema documentation — live interactive ER diagrams from your repo.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "schemat": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts dev --root ../../examples/blog"
  },
  "dependencies": {
    "@schemat/core": "workspace:*",
    "@schemat/parser-dbml": "workspace:*",
    "@schemat/parser-drizzle": "workspace:*",
    "@schemat/parser-mikroorm": "workspace:*",
    "@schemat/parser-mongoose": "workspace:*",
    "@schemat/parser-prisma": "workspace:*",
    "@schemat/parser-sequelize": "workspace:*",
    "@schemat/parser-sql": "workspace:*",
    "@schemat/parser-typeorm": "workspace:*",
    "@schemat/render": "workspace:*",
    "@schemat/web": "workspace:*",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/ws": "8.18.1",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "author": "Alireza Hamid <hi@ahamid.me>",
  "homepage": "https://github.com/alirezahamid/schemat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alirezahamid/schemat.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/alirezahamid/schemat/issues"
  },
  "keywords": [
    "prisma",
    "erd",
    "schema",
    "database",
    "er-diagram",
    "git-native",
    "documentation",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
