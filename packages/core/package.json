{
  "name": "@schemat/core",
  "version": "0.2.1",
  "description": "Canonical IR, parser interface, and differ for Schemat.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "author": "Alireza Hamid <hi@ahamid.me>",
  "homepage": "https://github.com/alirezahamid/schemat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alirezahamid/schemat.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/alirezahamid/schemat/issues"
  },
  "keywords": ["prisma", "erd", "schema", "ir", "database", "er-diagram"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
