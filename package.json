{
  "name": "@schemat/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Git-native database schema documentation. Live, interactive ER diagrams from your repo.",
  "license": "MIT",
  "author": "Alireza Hamid <hi@ahamid.me>",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "pnpm --filter @schemat/cli dev",
    "perf:large-schema:generate": "node scripts/generate-large-schema-fixture.mjs",
    "perf:large-schema": "node packages/cli/scripts/large-schema-smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm format",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "typescript": "7.0.2"
  }
}
